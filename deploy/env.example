# Copy file này thành ".env" ở thư mục gốc dự án TRÊN SERVER rồi điền giá trị thật.
# KHÔNG commit file .env. Tạo chuỗi ngẫu nhiên bằng: openssl rand -base64 48

# Địa chỉ người dùng mở web (chưa có tên miền thì dùng IP công khai của máy chủ)
PUBLIC_URL=http://203.0.113.10

# Mật khẩu quản trị Oracle (SYS/SYSTEM) - chỉ dùng khi bảo trì, sao lưu
ORACLE_ADMIN_PASSWORD=doi-mat-khau-nay

# Tài khoản database của ứng dụng (tự tạo ở lần chạy đầu)
DB_USERNAME=vocab
DB_PASSWORD=doi-mat-khau-nay

# Khóa ký JWT, tối thiểu 32 ký tự, KHÁC với máy dev
JWT_SECRET=dan-chuoi-tao-boi-openssl-rand-base64-48-vao-day

# Cổng web (mặc định 80)
HTTP_PORT=80
